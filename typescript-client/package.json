{
  "name": "@triton-one/yellowstone-fumarole-client",
  "version": "0.1.0",
  "description": "Yellowstone Fumarole client — native Node.js bindings via Rust/NAPI",
  "license": "AGPL-3.0",
  "author": "Triton One",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && tsc -p tsconfig.types.json",
    "build:native": "cd ../crates/yellowstone-fumarole-napi && npm install && npm run build",
    "generate-proto": "mkdir -p src/grpc && protoc -I../yellowstone-grpc/yellowstone-grpc-proto/proto -I../proto --plugin=node_modules/.bin/protoc-gen-ts_proto --ts_proto_opt=forceLong=bigint --ts_proto_opt=outputServices=grpc-js --experimental_allow_proto3_optional --ts_proto_out=src/grpc fumarole.proto --ts_proto_opt=esModuleInterop=true",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.6.3",
    "@grpc/grpc-js": "^1.13.4",
    "@triton-one/yellowstone-fumarole-napi": "file:../crates/yellowstone-fumarole-napi"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ts-proto": "^2.7.7",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">= 14"
  }
}
